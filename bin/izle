#!/bin/sh
# bin/izle — kanca desteği olmayan ajanlar (Cursor, ChatGPT, Gemini CLI vb.) için.
# lib/ veya test/ altında bir .rb dosyası kaydedildiğinde bin/kontrol'ü arka planda çalıştırır.
# Kullanım: bin/izle &
cd "$(dirname "$0")/.." || exit 1
son=""
while true; do
  imza=$(ls -l --time-style=+%s lib/*.rb test/*.rb 2>/dev/null | md5sum)
  if [ "$imza" != "$son" ]; then
    son="$imza"
    bin/kontrol
  fi
  sleep 1
done
